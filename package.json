{
  "name": "stramp",
  "version": "2.6.0",
  "description": "A JavaScript library that can convert any kind of data into binary that can be restored",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/Stramp.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/Stramp.d.ts"
    }
  },
  "scripts": {
    "test": "tsx tests/test.ts",
    "build": "tsc && rollup -c",
    "lint": "tsc --noEmit",
    "clean": "node tests/clean.js",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^26.0.1",
    "rollup": "^4.22.4"
  },
  "keywords": [
    "struct",
    "typed",
    "static",
    "binary",
    "serialize",
    "deserialize",
    "encode",
    "decode"
  ],
  "author": "larvance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larvance/bin.js.git"
  }
}
